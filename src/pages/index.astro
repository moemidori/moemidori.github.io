---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatarImage from '../assets/icon-256x256.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				display: flex;
				align-items: center;
				gap: 1.5rem;
				margin-bottom: 4rem;
				padding-top: 1rem;
			}
			.avatar {
				width: 80px;
				height: 80px;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid var(--border);
				flex-shrink: 0;
			}
			.intro-text h1,
			.intro-text h2 {
				font-size: 1.8rem;
				margin: 0 0 0.35rem 0;
				letter-spacing: -0.02em;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.intro-text .bio {
				font-size: 1.05rem;
				color: rgb(var(--gray-dark));
				line-height: 1.6;
				margin: 0;
			}

			.posts-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.75rem;
			}
			.posts-header h2 {
				font-size: 0.9rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--accent);
				margin: 0;
				font-weight: 700;
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex: 1;
			}
			.posts-header h2::after {
				content: '';
				flex: 1;
				height: 1px;
				background-color: var(--border);
				margin-right: 1rem;
			}
			.tags-link {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				text-decoration: none;
				padding: 2px 10px;
				border-radius: 9999px;
				border: 1px solid var(--border);
				background: var(--bg-subtle);
				transition: all 0.15s ease;
				white-space: nowrap;
			}
			.tags-link:hover {
				color: var(--accent);
				border-color: var(--accent);
			}

			.post-list {
				list-style-type: none;
				padding: 0;
				margin: 0;
			}
			.post-item {
				margin-bottom: 2rem;
			}
			.post-link {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				text-decoration: none;
				color: inherit;
				padding: 0.25rem 0;
				transition: all 0.15s ease;
			}
			.post-title {
				font-size: 1.35rem;
				color: rgb(var(--black));
				line-height: 1.4;
				font-weight: 600;
				letter-spacing: -0.01em;
				transition: color 0.15s ease;
			}
			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				font-size: 0.85rem;
				flex-wrap: wrap;
			}
			.post-date {
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
				transition: color 0.15s ease;
			}
			.tag-badge {
				font-size: 0.75rem;
				color: rgb(var(--gray));
				background-color: var(--bg-subtle);
				border: 1px solid var(--border);
				padding: 1px 7px;
				border-radius: 9999px;
				transition: all 0.15s ease;
			}
			.post-link:hover .post-title {
				color: var(--accent);
			}
			.post-link:hover .post-date {
				color: rgb(var(--gray-dark));
			}
			.post-link:hover .tag-badge {
				border-color: rgba(255, 119, 51, 0.4);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<Image
					src={avatarImage}
					alt={SITE_TITLE}
					width={160}
					height={160}
					class="avatar"
					loading="eager"
				/>
				<div class="intro-text">
					<h2>moemidori</h2>
					<p class="bio">
						ゲーム好きのエンジニア。
					</p>
				</div>
			</section>

			<section class="posts-section">
				<div class="posts-header">
					<h2>Articles</h2>
					<a href="/tags/" class="tags-link">#Tags</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`} class="post-link">
									<span class="post-title">{post.data.title}</span>
									<div class="post-meta">
										<span class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
										{
											post.data.tags?.map((t) => (
												<span class="tag-badge">#{t}</span>
											))
										}
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
