---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2.5em 1em;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				margin-bottom: 2rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				text-decoration: none;
				transition: color 0.15s ease;
			}
			.back-link:hover {
				color: var(--accent);
			}
			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
			}
			.article-header {
				margin-bottom: 2rem;
			}
			.article-header h1 {
				font-size: 1.75rem;
				line-height: 1.35;
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
			}
			.article-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 0.75rem;
			}
			.date {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
			}
			.last-updated-on {
				font-style: italic;
				margin-left: 0.5rem;
				color: rgb(var(--gray));
			}
			.article-tags {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.tag-badge {
				font-size: 0.75rem;
				color: rgb(var(--gray));
				background-color: var(--bg-subtle);
				border: 1px solid var(--border);
				padding: 1px 8px;
				border-radius: 9999px;
				text-decoration: none;
				transition: all 0.15s ease;
			}
			.tag-badge:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.divider {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 1.25rem 0 2rem 0;
			}
			.prose {
				color: rgb(var(--gray-dark));
				line-height: 1.85;
			}
			.prose h2 {
				font-size: 1.35rem;
				line-height: 1.4;
				margin-top: 2.5rem;
				margin-bottom: 0.85rem;
				padding-bottom: 0.35rem;
				border-bottom: 1px solid var(--border);
			}
			.prose h3 {
				font-size: 1.15rem;
				line-height: 1.45;
				margin-top: 2rem;
				margin-bottom: 0.6rem;
			}
			.prose h4 {
				font-size: 1.05rem;
				margin-top: 1.5rem;
				margin-bottom: 0.5rem;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<a href="/" class="back-link">← ホームに戻る</a>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="article-header">
					<div class="article-meta">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										(更新日: <FormattedDate date={updatedDate} />)
									</span>
								)
							}
						</div>
						{
							tags && tags.length > 0 && (
								<div class="article-tags">
									{tags.map((t) => (
										<a href={`/tags/${encodeURIComponent(t)}/`} class="tag-badge">
											#{t}
										</a>
									))}
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr class="divider" />
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
